<?xml version="1.0" encoding="utf-8"?>
<!--
  Hintergrund der Eingabefelder (v0.44). Auf dem fast schwarzen Grund reicht
  der Standard-Unterstrich einer EditText nicht mehr aus - man saehe nicht,
  wo man tippen kann. Deshalb eine eigene Flaeche, eine Spur heller als der
  Grund, mit demselben Rand wie die Tasten.

  Der Innenabstand steht hier und nicht im Layout, damit alle drei
  Zugangsfelder und das Nachrichtenfeld gleich aussehen, ohne ihn einzeln
  zu setzen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/feld_grund" />
    <stroke android:width="1dp" android:color="@color/taste_rand" />
    <corners android:radius="6dp" />
    <padding android:left="12dp" android:top="10dp"
             android:right="12dp" android:bottom="10dp" />
</shape>
