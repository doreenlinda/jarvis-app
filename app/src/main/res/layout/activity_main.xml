<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/seite"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Der Voice Orb steht GANZ OBEN. Seit v0.44 eine Glaskugel nach
             Doreens Vorlage (Variante B), und mit 230dp deutlich groesser
             als die 180dp davor.

             DIE HOEHE HAENGT AN DER REIHENFOLGE UNTEN: Der
             Zugangsdaten-Knopf stand frueher hier zwischen Orb und
             Eingabefeld. Er ist auf ihren Vorschlag nach unten gewandert
             ("dann haetten wir mehr Platz") - die gewonnenen ~48dp gehen
             hier hinein. Ohne sie muesste die Kugel beim Sprechen gestaucht
             werden und die Zustaende waeren schlechter zu unterscheiden.

             Die Statuszeile weiter unten bleibt bestehen: Sie nennt den
             WORTLAUT (Versionsnummer, Fehlermeldungen), der Orb nur den
             Zustand. Ein Bild ersetzt keine Diagnose. -->
        <com.jarvis.app.VoiceOrbView
            android:id="@+id/voiceOrb"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/messageText"
            android:background="@drawable/feld_dunkel"
            android:textColor="@color/feld_schrift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nachricht an Jarvis"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <!-- Die vier Haupttasten in EINER Reihe, klein und ohne Symbole
             (Doreens Wunsch vom 18.08.2026, nach der Vorschau: "Genau so
             angeordnet, kleiner Senden, Sprechen, Foto/Scannen, Stoppen und
             ohne die extra Symbole drauf ... das wuerde auch alles nochmal
             aufgeraeumter wirken lassen").

             Vorher standen sie als vier breite Balken untereinander und
             fuellten den halben Schirm.

             MITTIG statt ueber die volle Breite (ihre Wahl aus drei
             gezeigten Anordnungen): jede Taste nur so breit wie ihr Wort,
             die Gruppe zentriert.

             ZWEI DINGE, DIE HIER ZUSAMMENHAENGEN:
             - Der Weckwort-Knopf hat eine MINDESTBREITE. Sein Text wechselt
               zwischen "Aktivieren" und "Stoppen"; ohne sie wuerde beim
               Umschalten die ganze Reihe zur Seite ruecken, weil eine
               zentrierte Gruppe ihre Breite aus den Beschriftungen zieht.
             - Der SEITLICHE Innenabstand wird hier gesetzt und ueberstimmt
               damit bewusst die 16dp aus taste_graphit.xml. Bei vier Tasten
               nebeneinander waeren die zu breit. Ein im Layout gesetzter
               Abstand gewinnt - genau dafuer ist die Stelle im Drawable
               kommentiert. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/sendButton"
                android:background="@drawable/taste_graphit"
                android:textColor="@color/taste_schrift"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senden"
                android:textSize="12sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/talkButton"
                android:background="@drawable/taste_graphit"
                android:textColor="@color/taste_schrift"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="Sprechen"
                android:textSize="12sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/cameraButton"
                android:background="@drawable/taste_graphit"
                android:textColor="@color/taste_schrift"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="Foto"
                android:textSize="12sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/wakeButton"
                android:background="@drawable/taste_graphit"
                android:textColor="@color/taste_schrift"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="Aktivieren"
                android:minWidth="84dp"
                android:textSize="12sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- Zugangsdaten liegen hinter einem Schalter und sind standardmaessig
             ZU. Sie braucht sie nur einmal je Installation, aber sie landen
             auf jedem Screenshot - und Screenshots sind ihr wichtigstes
             Diagnosewerkzeug (die komplette Health-Sync-Suche lief ueber
             Bildschirmfotos).

             SEIT v0.44 HIER UNTEN statt direkt unter dem Orb (Doreens
             Vorschlag): Der Knopf war das einzige Element zwischen Orb und
             Eingabefeld, und der Platz gehoert jetzt der Kugel.

             Beim ersten Start ohne gespeicherte Daten klappt der Bereich
             automatisch auf UND die Seite scrollt hierher (siehe
             MainActivity) - sonst stuende sie vor einer App, deren
             Eingabefelder ausserhalb des Bildes liegen. -->
        <Button
            android:id="@+id/zugangToggle"
            android:background="@drawable/taste_graphit"
            android:textColor="@color/taste_schrift"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Zugangsdaten einblenden"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/zugangBereich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/serverUrl"
                android:background="@drawable/feld_dunkel"
                android:textColor="@color/feld_schrift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Server-URL (z. B. https://...ngrok-free.dev)"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/accessKey"
                android:background="@drawable/feld_dunkel"
                android:textColor="@color/feld_schrift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Zugangsschluessel"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/e2eKey"
                android:background="@drawable/feld_dunkel"
                android:textColor="@color/feld_schrift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Schluessel (E2E) - leer lassen = unverschluesselt"
                android:inputType="textPassword" />
        </LinearLayout>

        <!-- v0.42 (Doreens Wunsch, 18.08.2026): Die drei Schalter liegen
             hinter einem Knopf, "damit die App nicht so ueberladen wirkt".
             Standardmaessig ZU.

             Der Grund, aus dem sie frueher offen dastanden, bleibt dabei
             erhalten: Sie soll SEHEN, was gerade an ist, ohne erst zu
             tippen - deshalb traegt der Knopf im zugeklappten Zustand eine
             Kurzuebersicht (siehe aktualisiereEinstellungsUebersicht).
             Ohne die waere es ein Rueckschritt: Ob das WhatsApp-Mitlesen
             laeuft, war im Alltag schon einmal die entscheidende Frage. -->
        <Button
            android:id="@+id/einstellungenToggle"
            android:background="@drawable/taste_graphit"
            android:textColor="@color/taste_schrift"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Einstellungen einblenden"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/einstellungenBereich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- v0.31: Standort mitschicken. Seit v0.42 eingeklappt (siehe
                 oben) - der Schalter ist dafuer da, dass sie die Ortung im
                 Vorbeigehen abstellen kann, ohne die Berechtigung
                 in den Android-Einstellungen zurueckzunehmen. Darunter steht,
                 welchen Ort die App gerade kennt: Ohne diese Anzeige waere im
                 Alltag nicht pruefbar, ob die Ortung ueberhaupt etwas liefert. -->
            <CheckBox
                android:id="@+id/standortSchalter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="14sp"
                android:text="Standort mitschicken (für Empfehlungen unterwegs)" />

            <TextView
                android:id="@+id/standortInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="@color/status_schrift"
                android:text="" />

            <!-- v0.32: WhatsApp mitlesen. Wie beim Standort zwei Schalter - der
                 Systemzugriff auf Benachrichtigungen UND dieser hier, damit sich
                 das Mitlesen im Vorbeigehen abstellen laesst, ohne die
                 Systemberechtigung zurueckzunehmen. Darunter steht, ob der
                 Zugriff ueberhaupt erteilt ist; ohne diese Anzeige waere im
                 Alltag nicht erkennbar, warum nichts ankommt. -->
            <CheckBox
                android:id="@+id/whatsappSchalter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="14sp"
                android:text="WhatsApp mitlesen (Terminabsagen von Kundinnen)" />

            <TextView
                android:id="@+id/whatsappInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="@color/status_schrift"
                android:text="" />

            <!-- v0.33: Standardmaessig AUS. Eine dringende Meldung kann eine sehr
                 persoenliche Notlage betreffen - laut vorgelesen im Kundengespraech
                 waere das der teure Fehler. Wer den Haken im Auto setzt und
                 vergisst zurueckzustellen, faellt in den sicheren Zustand. -->
            <CheckBox
                android:id="@+id/inhaltVorlesenSchalter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:text="Dringendes laut vorlesen" />

            <TextView
                android:id="@+id/inhaltVorlesenInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="@color/status_schrift"
                android:text="" />
        </LinearLayout>


        <TextView
            android:id="@+id/wakeStatusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="@color/status_schrift"
            android:text="" />

        <TextView
            android:id="@+id/answerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textSize="16sp"
            android:textColor="@color/feld_schrift"
            android:textIsSelectable="true"
            android:text="" />

        <!-- Nachrichten, die Jarvis von sich aus schickt (Briefings,
             Manus-Ergebnisse). Wird in MainActivity programmatisch
             gefuellt - eine Liste mit wenigen Eintraegen braucht keine
             eigene Listen-Mechanik. -->
        <TextView
            android:id="@+id/postfachTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:paddingBottom="4dp"
            android:textSize="18sp"
            android:textColor="@color/feld_schrift"
            android:text="Nachrichten von Jarvis" />

        <LinearLayout
            android:id="@+id/postfachListe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </LinearLayout>
</ScrollView>
